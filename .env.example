# =============================================================================
# WarehouseOps AI — Environment Configuration
# =============================================================================
# Copy to .env and fill in your Groq key:  cp .env.example .env
# Runs on free infrastructure — no Postgres, no Milvus, no GPU.
# =============================================================================

ENVIRONMENT=development

# -----------------------------------------------------------------------------
# LLM (chat) — Groq by default, or a local Ollama server
# -----------------------------------------------------------------------------
# Chat backend: "groq" (default) or "ollama"
LLM_PROVIDER=groq

# Groq (default): free, OpenAI-compatible. Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1   # auto-selected; override if needed

# Local Ollama (offline, zero cost): set LLM_PROVIDER=ollama, then
#   ollama pull qwen2.5:7b-instruct
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct   # no API key required

# Generation params
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TOP_P=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
LLM_CLIENT_TIMEOUT=120

# Response caching
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Embeddings — local sentence-transformers (CPU, no API key)
# -----------------------------------------------------------------------------
# First run downloads the model (~80MB) and caches it.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# Database — local SQLite (auto-created + seeded by init_local_db.py)
# -----------------------------------------------------------------------------
# WAREHOUSE_DB_PATH=data/warehouse.db

# -----------------------------------------------------------------------------
# Vector store — local ChromaDB (persistent, no server)
# -----------------------------------------------------------------------------
# CHROMA_DIR=data/chroma
# CHROMA_COLLECTION=warehouse_docs

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32   (REQUIRED in production)
JWT_SECRET_KEY=your-strong-random-secret-minimum-32-characters-change-this
DEFAULT_ADMIN_PASSWORD=changeme
DEFAULT_USER_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Guardrails (optional) — reuses the LLM backend
# -----------------------------------------------------------------------------
# RAIL_API_KEY defaults to GROQ_API_KEY if unset. Leave blank to use
# pattern-based guardrails only.
# RAIL_API_KEY=

# -----------------------------------------------------------------------------
# Web / limits
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
MAX_REQUEST_SIZE=10485760      # 10 MB
MAX_UPLOAD_SIZE=52428800       # 50 MB

# -----------------------------------------------------------------------------
# Redis (optional — in-memory fallback used if absent)
# -----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Notes:
#  - Never commit your .env.
#  - Quick start: see LOCAL_TEST.md
